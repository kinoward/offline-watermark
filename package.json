{
  "name": "offline-watermark",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build",
    "build:offline": "npm run check && node scripts/build-offline.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/unit/*.test.mjs",
    "test:browser": "node tests/browser/smoke.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs"
  },
  "dependencies": {
    "@hyzyla/pdfium": "3.0.0",
    "@imagemagick/magick-wasm": "0.0.46",
    "@pdf-lib/upng": "1.0.1",
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "playwright": "1.61.1",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  },
  "license": "MIT"
}
